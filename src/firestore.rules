
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------
    // Helper Functions
    // --------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOfficer() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_officer/$(request.auth.uid));
    }
    
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isMember() {
       return isSignedIn() && exists(/databases/$(database)/documents/players/$(request.auth.uid));
    }

    // --------------------------------
    // Collection Rules
    // --------------------------------

    // Players can be read by any member.
    // The owner can update their own profile.
    // An Admin can create a player profile (for initial setup).
    match /players/{playerId} {
      allow read: if isMember();
      allow create: if isAdmin();
      allow write: if isOwner(playerId);
    }
    
    // User-specific data is only accessible by the owner.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Applications can be created by any signed-in user.
    // They can only be read/listed if the user is an officer, admin, or the owner of the application.
    match /applications/{applicationId} {
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow get: if isOwner(resource.data.userId) || isOfficer() || isAdmin();
        
        // A user can LIST applications IF their query is filtering for their own userId.
        // This is secure because it prevents listing all applications.
        allow list: if (isOfficer() || isAdmin()) || (isSignedIn() && request.query.where.userId == request.auth.uid);
        
        allow update, delete: if isOwner(resource.data.userId) || isOfficer() || isAdmin();
    }


    // Global data is readable by members/officers, but only writable by officers/admins.
    match /bounty_board_quests/{questId} {
      allow read: if isMember() || isOfficer() || isAdmin();
      allow write: if isOfficer() || isAdmin();
    }
    
    match /guild_bank_items/{itemId} {
      allow read: if isMember();
      allow write: if isOfficer() || isAdmin();
    }

    // Role documents are protected.
    // An admin can create new officer roles.
    match /roles_officer/{userId} {
      allow read, write: if isAdmin();
    }

    // An admin can create other admin roles.
    // CRITICAL: To initialize the FIRST admin, we allow any signed-in user to create a role *only if the collection is empty*.
    match /roles_admin/{userId} {
        allow read: if isAdmin();
        allow write: if isAdmin() || (isSignedIn() && !exists(/databases/$(database)/documents/roles_admin));
    }

    // Fallback rule: deny all other access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
