
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------
    // Helper Functions
    // --------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getGuildId() {
      return request.auth.token.guildId;
    }

    function isOfficer() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/roles_officer/$(request.auth.uid));
    }
    
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isMember() {
       // A user is a member if they have a player document in the current guild.
       return isSignedIn() && exists(/databases/$(database)/documents/players/$(request.auth.uid));
    }

    // --------------------------------
    // Collection Rules
    // --------------------------------

    // Players can be read by any member of the SAME guild.
    // The owner can update their own profile.
    // An officer or admin of the same guild can update any profile.
    match /players/{playerId} {
      allow read: if isOwner(playerId) || (isMember() && resource.data.guildId == getGuildId());
      allow create: if isAdmin();
      // Allow self-writes for non-restricted fields.
      allow update: if (
                      // Profile updates by owner (no role/rank changes)
                      (isOwner(playerId) && !('rank' in request.resource.data) && !('role' in request.resource.data) && resource.data.guildId == getGuildId()) 
                      // Bounty reward deduction
                      || (isOwner(playerId) && request.resource.data.currentHonor == resource.data.currentHonor - get(/databases/$(database)/documents/member_bounties/$(request.resource.data.bountyId)).data.reward && resource.data.guildId == getGuildId())
                      // Officer/Admin overrides
                      || ((isOfficer() || isAdmin()) && resource.data.guildId == getGuildId())
                    );
    }
    
    // User-specific data is only accessible by the owner.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // This rule allows a collection group query on 'characters'.
    // Any member can read any character for global stats, but only the owner can write.
    match /{path=**}/characters/{characterId} {
      allow read: if isMember();
      allow write: if isOwner(resource.data.playerId);
    }

    // Applications can be created by any signed-in user.
    // They can only be read/listed if the user is an officer, admin, or the owner of the application.
    match /applications/{applicationId} {
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        // A user can get their own application, or an officer/admin can get any.
        allow get: if isOwner(applicationId) || isOfficer() || isAdmin();
        // A user can query for their own application; officers/admins can query all.
        allow list: if (isOfficer() || isAdmin()) || (isSignedIn() && request.query.where[0][2] == request.auth.uid);
        allow update: if isOfficer() || isAdmin() || isOwner(applicationId);
        allow delete: if isOwner(applicationId) || isOfficer() || isAdmin();
    }

    // Global data is readable by members/officers, but only writable by officers/admins.
    match /bounty_board_quests/{questId} {
      allow get, list: if true;
      allow write: if isOfficer() || isAdmin();
    }
    
    match /guild_bank_items/{itemId} {
      allow read: if isSignedIn();
      allow write: if isOfficer() || isAdmin();
    }
    
    // Member Bounties have specific rules
    match /member_bounties/{bountyId} {
      allow read: if isSignedIn();
      
      // Create: You must be the one creating it, and your honor must be sufficient.
      allow create: if isSignedIn() && request.resource.data.requestingPlayerId == request.auth.uid
      						&& get(/databases/$(database)/documents/players/$(request.auth.uid)).data.currentHonor >= request.resource.data.reward;
      
      // Update: You can accept a bounty (not your own), or if you are the creator, you can mark it complete.
      allow update: if isSignedIn() && (
                        // Accepting a bounty
                        (request.resource.data.status == 'in_progress' && resource.data.status == 'open' && request.resource.data.acceptedPlayerId == request.auth.uid && resource.data.requestingPlayerId != request.auth.uid) ||
                        // Completing a bounty (only status change, honor is handled by function)
                        (request.resource.data.status == 'complete' && resource.data.status == 'in_progress' && resource.data.requestingPlayerId == request.auth.uid)
                       );
                       
      allow delete: if false; // Bounties are completed, not deleted.
    }

    match /settings/guild {
      allow read: if true;
      allow write: if isOfficer() || isAdmin();
    }

    match /runs/{runId}/{document=**} {
      allow read, write: if isMember();
    }
    
    // Role documents are protected.
    // An admin can create new officer roles.
    match /roles_officer/{userId} {
      allow read, write: if isAdmin();
    }

    // An admin can create other admin roles.
    // CRITICAL: To initialize the FIRST admin, we allow any signed-in user to create a role *only if the collection is empty*.
    match /roles_admin/{userId} {
        allow read: if isAdmin();
        allow write: if isAdmin() || (isSignedIn() && !exists(/databases/$(database)/documents/roles_admin));
    }
  }
}

    